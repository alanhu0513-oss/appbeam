# ---------------------------------------------------------------------------
# Appbeam pipeline configuration
# Copy to `.env` at the repo root:  cp .env.example .env
# The pipeline reads this file automatically (Next.js only reads apps/dashboard/.env*).
# ---------------------------------------------------------------------------

# PIPELINE_MODE: "auto" (use real services when keys exist, mock otherwise),
#               "real" (fail loudly if a key is missing), "mock" (never call out).
PIPELINE_MODE=auto

# --- Google Gemini (Google AI Studio) --------------------------------------
# Create a key at https://aistudio.google.com/apikey and paste it below.
# Dashboard users can also BYO: the Settings panel sends their key per-request
# as an `x-gemini-key` header, which overrides this value.
GEMINI_API_KEY=

# Default is the spec'd gemini-1.5-pro. NOTE: 1.5 Pro has been retired from the
# Gemini developer API; if requests fail with a model-not-found error, set an
# available Pro model (e.g. gemini-2.5-pro / gemini-3.1-pro).
GEMINI_MODEL=gemini-1.5-pro

# --- Vercel (Platforms API) ------------------------------------------------
# Create a token at https://vercel.com/account/tokens (Full Account scope).
# Dashboard users can also BYO: the Settings panel sends their token per-request
# as an `x-vercel-token` header, which overrides this value.
VERCEL_TOKEN=
# Optional: scope the API calls to a team (team_xxx or team slug).
VERCEL_TEAM_ID=
# Project created/used by the deployer.
VERCEL_PROJECT_NAME=appbeam-preview

# --- REA (morluto/rea reverse-engineering agent) ---------------------------
# How the intake stage talks to REA: "cli" (npx rea-agents analyze) or "mcp"
# (stdio MCP server) or "mock" (fixture payload, no REA install needed).
REA_MODE=cli
# Optional pinned CLI invocation, e.g. "rea" (global install) or "npx -y rea-agents@latest".
REA_COMMAND=npx -y rea-agents@latest
# Extra args appended to `rea analyze`, e.g. "--provider ghidra".
REA_ARGS=
REA_TIMEOUT_MS=600000

# --- Simulator template ----------------------------------------------------
# Where the Gemini output is injected and zipped from (auto-detected if unset).
SIMULATOR_TEMPLATE_DIR=
# Entry file overwritten inside the template (auto-detected: App.tsx > App.ts > App.js).
SIMULATOR_ENTRY_FILE=
# "1" stages a per-run copy of the template instead of mutating it in place.
# Recommended (=1) for public/hosted instances; the dashboard always stages
# per-session anyway. The CLI mutates in place unless this is set or --staging.
PIPELINE_STAGING=

# --- Inference limits ------------------------------------------------------
# REA evidence can be enormous; only this many characters ship to Gemini
# (head + tail truncated with a marker when exceeded).
GEMINI_MAX_PAYLOAD_CHARS=400000
VERCEL_DEPLOY_TIMEOUT_MS=600000
