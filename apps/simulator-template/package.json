{
  "name": "@appbeam/simulator-template",
  "version": "0.1.0",
  "private": true,
  "description": "Blank Expo React Native Web canvas that the Appbeam pipeline overwrites and deploys to Vercel.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~4.0.0",
    "expo": "~52.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "~0.76.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
